{
  "name": "dsh-larklink",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p packages/cli --noEmit && tsc -p packages/plugin --noEmit",
    "larklink": "tsx packages/cli/bin/larklink.ts",
    "build:plugin": "pnpm --filter @timeryu288/dsh-larklink build"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@timeryu288/larklink-cli": "workspace:*",
    "@timeryu288/larklink-core": "workspace:*",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.6"
  }
}
